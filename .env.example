# ---------------------------------------------------------------------------
# Islanda — environment template
# Copy to .env.local. NEVER commit .env.local (Security Architecture).
# All values are validated at boot by lib/env.ts — the app will refuse to start
# rather than run in a half-configured state.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (NEXT_PUBLIC_ prefix required by Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only access gate. Defaults to false in development and true in production.
# Keep true for the public waitlist launch; set false only when opening the application.
WAITLIST_ONLY_MODE=false

# Server-only — MUST NOT be prefixed NEXT_PUBLIC_. Bypasses RLS; use only in
# trusted server contexts (migrations, seeding, admin scripts). Never in a
# request path that serves user data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# RLS integration tests (tests/rls/)
# These run against a REAL project with REAL sessions — mocking would test the
# mock, not the security boundary. Two pre-provisioned users are required.
# CI sets RLS_TESTS_REQUIRED=1 so a missing configuration FAILS rather than
# silently skipping the security suite.
# ---------------------------------------------------------------------------
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
RLS_TESTS_REQUIRED=0

# Used by `npm run db:types`
SUPABASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# Fish Audio — Nova's optional speaking voice (server-side TTS)
# Server-only. FISH_API_KEY is a paid-provider bearer credential: it MUST NOT
# be prefixed NEXT_PUBLIC_, must never reach the browser, and must never be
# logged or committed. Nova works fully without these; /api/nova/speak returns
# 503 when they are absent, so leaving them blank is a supported configuration.
# FISH_NOVA_VOICE_ID is the reference id of the trained Nova voice model.
# ---------------------------------------------------------------------------
FISH_API_KEY=
FISH_NOVA_VOICE_ID=

# Islanda public waitlist email delivery (server-only, via Resend)
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=Islanda <waitlist@solvanehub.us>
WAITLIST_NOTIFICATION_EMAIL=info@solvanehub.us
